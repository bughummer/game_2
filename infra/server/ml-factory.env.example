# ML Factory MCP server — environment for the internal server (copy to /etc/ml-factory/ml-factory.env,
# chmod 600, owned by the service user). Every setting is read by backend/config.py.
# List values are JSON arrays. Lines marked REQUIRED make /health report "degraded" when missing.

# --- AWS identity -------------------------------------------------------------------------------
ML_FACTORY_AWS_REGION=us-east-1
# The control-plane role the server assumes (infra/iam/control_plane_policy.json). The server's
# base credentials only need sts:AssumeRole on it (infra/iam/server_base_identity_policy.json).
ML_FACTORY_AWS_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/mlf-control-plane
# Base credentials come from the standard AWS chain. Either a named profile on the box:
# ML_FACTORY_AWS_PROFILE=ml-factory
# ...or point the SDK at a credentials file readable only by the service user:
# AWS_SHARED_CREDENTIALS_FILE=/etc/ml-factory/aws-credentials
# Only if outbound HTTPS to AWS goes through a proxy:
# ML_FACTORY_HTTPS_PROXY=http://proxy.internal:3128

# --- storage (REQUIRED) -------------------------------------------------------------------------
ML_FACTORY_ARTIFACT_ROOT=s3://<ARTIFACT_BUCKET>/ml-factory-prod
# SSE-S3 by default. For KMS: ML_FACTORY_S3_SSE=aws:kms and ML_FACTORY_S3_KMS_KEY_ID=<key arn>
ML_FACTORY_S3_SSE=AES256
# Extra approved dataset locations besides the upload inbox (JSON array):
# ML_FACTORY_ALLOWED_DATASET_PREFIXES=["s3://<DATA_BUCKET>/curated"]

# --- SageMaker (REQUIRED) -----------------------------------------------------------------------
ML_FACTORY_SAGEMAKER_EXECUTION_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/mlf-sagemaker-job
# Pin the image by digest, not by tag.
ML_FACTORY_STAGE_IMAGE_URI=<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/ml-factory-stage@sha256:<DIGEST>
ML_FACTORY_TRAINING_INSTANCE_TYPE=ml.m5.large
ML_FACTORY_PROCESSING_INSTANCE_TYPE=ml.m5.large
ML_FACTORY_SPOT_ENABLED=true
ML_FACTORY_SPOT_MAX_WAIT_SECONDS=3600
# Only if jobs must run inside a VPC (both lists, JSON arrays):
# ML_FACTORY_VPC_SUBNET_IDS=["subnet-..."]
# ML_FACTORY_VPC_SECURITY_GROUP_IDS=["sg-..."]

# --- status poller ------------------------------------------------------------------------------
# Advances every experiment between stages. Exactly ONE running server per artifact root may
# poll; set 0 on any other instance.
ML_FACTORY_STATUS_POLL_INTERVAL_SECONDS=30

# --- identity (placeholder until LibreChat auth is wired) ---------------------------------------
# Every caller is treated as this one user. Not a security boundary.
ML_FACTORY_DEV_IDENTITY=ml-factory-pilot

# --- Bedrock (optional; LLM reasoning + feature proposals) --------------------------------------
ML_FACTORY_BEDROCK_ENABLED=false
# ML_FACTORY_BEDROCK_MODEL_ID=us.anthropic.<model-id>

# --- MCP transport ------------------------------------------------------------------------------
ML_FACTORY_MCP_PORT=8000
# Defaults: transport sse, path /sse, host 0.0.0.0 (see mcp_server/app.py).
# ML_FACTORY_MCP_HOST=0.0.0.0
ML_FACTORY_LOG_LEVEL=INFO
